# Copy this file to `.env.local` and fill in the real values.
# Never commit `.env.local` or any file containing real secrets.

# ---- Public (exposed to the browser) ----
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# App canonical URL (used for auth callbacks, share links, TV refresh).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Server-only (never exposed to the browser) ----
# Service role key: ONLY used in Server Actions / Route Handlers.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Transactional email via Resend (magic links + invites).
RESEND_API_KEY="re_..."
RESEND_FROM="LEV Dashboard <login@eco-sociaal.nl>"
# RESEND_REPLY_TO="support@example.com"

# ---- Security ----
# Space-separated list of origins allowed to embed the /embed/* routes.
# Example: "'self' https://intranet.levgroep.be"
EMBED_FRAME_ANCESTORS="'self'"
